{
  "manifest_version": 3,
  "name": "Slop Score Rating (SSR)",
  "version": "0.1.0",
  "description": "Scores the current page for AI-generated writing.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Slop Score Rating",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["rank.js", "content.js"]
    }
  ]
}
